---
const { locale } = Astro.locals.starlightRoute;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/${locale ? `${locale}/` : ''}`;
---
<a class="site-title" href={home} aria-label="PotLuck">
    <img src={`${base}/favicon.svg`} width="32" height="32" alt="" />
    <span>potluck<span class="brand-dot">.</span></span>
</a>
